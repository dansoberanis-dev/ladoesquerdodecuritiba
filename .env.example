# =====================================================================
#  Variáveis de ambiente — cole na Vercel (Settings → Environment Variables)
#  Este arquivo é só documentação: NÃO comite o .env com valores reais.
# =====================================================================

# ---------- BLOG (Notion) ----------
# Integração: https://www.notion.so/my-integrations  → New integration → Internal
# Depois: banco no Notion → ••• → Connections → Connect to → sua integração
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID do banco: os 32 caracteres antes do "?v=" na URL do banco
NOTION_DATABASE_ID=1a2b3c4d5e6f7890abcdef1234567890

# ---------- REDES SOCIAIS (Instagram) ----------
# Conta precisa ser Business ou Creator, vinculada a uma Página do Facebook.
# App em https://developers.facebook.com → Instagram Graph API
# Permissão: instagram_basic
INSTAGRAM_TOKEN=IGQVJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID da conta profissional (NÃO é o @usuario)
INSTAGRAM_USER_ID=17841400000000000
# Cache na CDN em segundos (padrão 3600 = 1 hora)
INSTAGRAM_CACHE=3600
